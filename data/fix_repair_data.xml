<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds 'Not Under Warranty' to the Studio-managed x_studio_quotation_type
         selection field. Runs on every install and upgrade. -->
    <function model="sale.order" name="_ensure_not_under_warranty_selection"/>

    <!-- Deactivates the Studio automation "RR - Auto Select Product for RUG Repairs-33"
         which unconditionally clears product_id when x_studio_serial_no changes,
         overwriting our Python onchange. Clearing logic is in _onchange_serial_no_product. -->
    <function model="helpdesk.ticket" name="_deactivate_clearing_serial_automation"/>

    <!-- Fix Studio server action "Create Advance Payment" that passes record.id
         (sale.order id) into x_studio_project_no_1 (Many2one → project.project),
         causing a FK violation. Replaces it with record.x_studio_project_no.id. -->
    <function model="sale.order" name="_fix_advance_payment_project_field"/>

    <!-- Rewrite four Studio server actions on sale.order that fire on every
         write and unconditionally call record.write(...). Guarded versions
         perform the same functional work but skip the write when values are
         already at target — eliminating the write cascade that made Create
         Draft Invoice take minutes. Idempotent via a marker string; if the
         action's code has already been patched (or manually edited to
         include the marker), the rewrite is skipped. -->
    <function model="sale.order" name="_optimize_slow_write_automations"/>

    <!-- Convert redundant stored Studio compute fields into related fields
         so they don't recompute during write cascades. Same functional
         result — Odoo resolves the value natively instead of safe_eval'ing
         Python code every write. Only touches fields whose compute is a
         known redundant pattern; manual Studio edits are preserved. -->
    <function model="sale.order" name="_optimize_slow_studio_computes"/>

    <!-- Rewrite heavy Studio computes on sale.order to one-line
         delegations that call native Python methods. safe_eval only
         executes the delegating call; the actual work runs at native
         CPython speed. Field names and returned values unchanged —
         Studio UI still recognises the fields, and any view/filter that
         reads them still gets the same result. -->
    <function model="sale.order" name="_delegate_studio_computes_to_native"/>

    <!-- Same delegation treatment for account.move.line studio computes
         (x_studio_credit_limit_2). Reads partner.credit_limit natively
         instead of via safe_eval on every AML write. -->
    <function model="account.move.line" name="_delegate_studio_computes_to_native"/>

    <!-- Same delegation treatment for stock.picking studio computes.
         Eight unstored heavy computes on stock.picking (referenced by
         the Studio picking form) are re-run via safe_eval on every
         view render — including the one that fires right after
         button_validate. Rewriting each compute string to a one-line
         call into a native Python method eliminates the per-view
         safe_eval overhead. Field values unchanged. -->
    <function model="stock.picking" name="_delegate_studio_computes_to_native"/>

    <!-- Restrict 'PROJ - Notify Transfer Completion' to fire only when a
         Project-flow picking transitions to state='done'. Was firing on
         every stock.picking write of every type (Repair, NUW, internal),
         creating duplicate mail.activity records per write — direct
         cause of delivery-Validate slowness. Functional intent
         preserved: Project transfers still get the To-Do activity;
         other transfers no longer trigger it. -->
    <function model="sale.order" name="_restrict_notify_transfer_completion_automation"/>

    <!-- Seed default factory_repair_location per company. Idempotent:
         only sets when ir.config_parameter for that company is empty,
         so manual overrides via Settings → Technical → System Parameters
         survive subsequent upgrades. -->
    <function model="stock.warehouse" name="_seed_factory_repair_locations"/>

    <!-- Add a child 'Intransit' (usage='transit') location under every
         non-intransit warehouse on every company, so we get the
         <CODE>/Intransit convention (e.g. PW-JM/Intransit, BR-AM/Intransit).
         Idempotent: skipped when the child already exists. -->
    <function model="stock.warehouse" name="_seed_intransit_locations"/>

    <!-- Add a child 'Repair' (usage='repair') location under every
         non-intransit warehouse on every company, mirroring the
         Intransit seeding above. Idempotent. -->
    <function model="stock.warehouse" name="_seed_repair_locations"/>
</odoo>
