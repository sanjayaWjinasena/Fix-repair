<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Adds 'Not Under Warranty' to the Studio-managed x_studio_quotation_type
         selection field. Runs on every install and upgrade. -->
    <function model="sale.order" name="_ensure_not_under_warranty_selection"/>

    <!-- Deactivates the Studio automation "RR - Auto Select Product for RUG Repairs-33"
         which unconditionally clears product_id when x_studio_serial_no changes,
         overwriting our Python onchange. Clearing logic is in _onchange_serial_no_product. -->
    <function model="helpdesk.ticket" name="_deactivate_clearing_serial_automation"/>

    <!-- Fix Studio server action "Create Advance Payment" that passes record.id
         (sale.order id) into x_studio_project_no_1 (Many2one → project.project),
         causing a FK violation. Replaces it with record.x_studio_project_no.id. -->
    <function model="sale.order" name="_fix_advance_payment_project_field"/>

    <!-- Seed default factory_repair_location per company. Idempotent:
         only sets when ir.config_parameter for that company is empty,
         so manual overrides via Settings → Technical → System Parameters
         survive subsequent upgrades. -->
    <function model="stock.warehouse" name="_seed_factory_repair_locations"/>

    <!-- Pre-create one in-transit warehouse (IT-<XX>) per source warehouse
         across all companies. Idempotent: leaves existing IW-/IB-/IT-
         intransit pairings alone. Ensures the Send/Received-at-Factory
         flow has a destination ready without lazy creation on click. -->
    <function model="stock.warehouse" name="_seed_intransit_warehouses"/>
</odoo>
