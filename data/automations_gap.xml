<?xml version="1.0" encoding="utf-8"?>
<!-- Fix-repair: 16 gap automations -->
<odoo>


  <record id="base_automation_171_jin_helpdesk_repair_seq_no" model="base.automation">
    <field name="name">JIN-Helpdesk(Repair) Seq.No</field>
    <field name="active" eval="False"/>
    <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
    <field name="trigger">on_create_or_write</field>
    <field name="action_server_ids" eval="[(6, 0, [ref('Fix-repair.server_action_1976_rr_repair_seq_no')])]"/>
  </record>

