    <field name="trigger">on_unlink</field>
    <field name="filter_domain">[["x_studio_cancelled","=",True]]</field>
    <field name="action_server_ids" eval="[(6, 0, [ref('Fix-repair.server_action_2222_rr_validate_cancelled_tickets')])]"/>
  </record>

