<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chunk 1a (v241) — 6 diagnosis catalogues -->
    <record id="model_conditions" model="ir.model">
        <field name="name">Conditions</field>
        <field name="model">conditions</field>
    </record>
    <record id="model_symptom_areas" model="ir.model">
        <field name="name">Symptom Areas</field>
        <field name="model">symptom_areas</field>
    </record>
    <record id="model_symptom_codes" model="ir.model">
        <field name="name">Symptom Codes</field>
        <field name="model">symptom_codes</field>
    </record>
    <record id="model_diagnosis_areas" model="ir.model">
        <field name="name">Diagnosis Areas</field>
        <field name="model">diagnosis_areas</field>
    </record>
    <record id="model_diagnosis_codes" model="ir.model">
        <field name="name">Diagnosis Codes</field>
        <field name="model">diagnosis_codes</field>
    </record>
    <record id="model_resolutions" model="ir.model">
        <field name="name">Resolutions</field>
        <field name="model">resolutions</field>
    </record>
    <!-- Pre-Chunk-1a (v227 and earlier) — 5 repair-master models -->
    <record id="model_repair_accounts" model="ir.model">
        <field name="name">Repair Accounts</field>
        <field name="model">repair_accounts</field>
    </record>
    <record id="model_repair_reason" model="ir.model">
        <field name="name">Repair Reason</field>
        <field name="model">repair_reason</field>
    </record>
    <record id="model_repair_reason_custom" model="ir.model">
        <field name="name">Repair Reason - Customer</field>
        <field name="model">repair_reason_custom</field>
    </record>
    <record id="model_repair_stages" model="ir.model">
        <field name="name">Repair Stages</field>
        <field name="model">repair_stages</field>
    </record>
    <record id="model_repair_sub_reason" model="ir.model">
        <field name="name">Repair Sub Reason</field>
        <field name="model">repair_sub_reason</field>
    </record>
    <!-- v227 — Task Diagnosis (the one that triggered the current failure) -->
    <record id="model_task_diagnosis" model="ir.model">
        <field name="name">Task Diagnosis</field>
        <field name="model">task_diagnosis</field>
    </record>
</odoo>
