<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_task_repair_diagnosis" model="ir.ui.view">
        <field name="name">project.task.form.repair.diagnosis</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Sentinel: helpdesk_ticket_id must be present in the
                 composed arch for OWL to evaluate the page's invisible
                 modifier. project_task._get_view adds this at runtime
                 too but view-arch validation runs at install time
                 before _get_view. Belt-and-braces here. -->
            <xpath expr="//sheet" position="inside">
                <field name="helpdesk_ticket_id" invisible="1" string="Help Desk Ticket (sentinel)"/>
                <!-- v266: sentinels for the Tested OK button's invisible
                     expression. project_task._get_view runtime-injects
                     these too, but install-time view validation runs
                     before _get_view. -->
                <field name="end_quick_repair" invisible="1"/>
                <field name="cancelled" invisible="1"/>
                <field name="material_line_product_count" invisible="1"/>
            </xpath>

            <!-- v265: Tested OK header button — matches Clear-DB's
                 Studio arch verbatim (invisible expression identical),
                 binds to Fix-repair.action_repair_end_quick_repair
                 (delegates to project.task._repair_studio_end_quick_repair
                 in models/project_task.py:521). Insert AFTER the
                 personal_stage_type_id field, same slot Clear-DB
                 view 3019 uses. -->
            <xpath expr="//field[@name='personal_stage_type_id']" position="after">
                <button name="%(Fix-repair.action_repair_end_quick_repair)d" type="action" string="Tested OK" class="btn-primary" invisible="material_line_product_count &gt; 0 or cancelled == True or not helpdesk_ticket_id or end_quick_repair == True"/>
            </xpath>

            <!-- v261: header field insertions matching Clear-DB Studio
                 view 3019 verbatim. Rename user_ids label + insert
                 helpdesk_ticket_id / created_date /
                 repair_reason (invisible). Show sale_order_id
                 and rename to Studio's typo "Sales Orderr" for
                 parity. Insert custom_reports_priority / _quotation_type /
                 _material_availability after sale_order_id. -->
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="string">Assignees</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="helpdesk_ticket_id" string="Help Desk Ticket"/>
                <field name="created_date"/>
                <field name="repair_reason" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="string">Sales Orderr</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="after">
                <field name="custom_reports_priority"/>
                <field name="quotation_type"/>
                <field name="material_availability"/>
            </xpath>
        </field>
    </record>
  <record id="view_project_task_form" model="ir.ui.view">
    <field name="name">Fix-repair.project.task.form.hide.worksheet.dup.buttons</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="industry_fsm_report.view_task_form2_inherit"/>
    <field name="priority">20</field>
    <field name="arch" type="xml">

      <xpath expr="//button[@name='action_preview_worksheet'][2]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <xpath expr="//button[@name='action_send_report'][2]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

    </field>
  </record>
  <record id="view_project_task_form_2" model="ir.ui.view">
    <field name="name">Fix-repair.project.task.form.view_so_cancelled_guard</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="sale_project.view_sale_project_inherit_form"/>
    <field name="priority">110</field>
    <field name="arch" type="xml">

      <xpath expr="//button[@name='action_view_so']" position="attributes">
        <attribute name="invisible">(sale_order_id == False) or (cancelled == True)</attribute>
      </xpath>

    </field>
  </record>
    <record id="view_project_task_repair_diagnosis_page" model="ir.ui.view">
        <field name="name">project.task.form.repair.diagnosis.page</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Repair Diagnosis" name="repair_diagnosis" invisible="not helpdesk_ticket_id">
                    <field name="diagnosis_ids" nolabel="1" force_save="1" required="helpdesk_ticket_id">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" column_invisible="True"/>
                            <field name="condition" column_invisible="True"/>
                            <field name="symptom_area" column_invisible="True"/>
                            <field name="symptom_code" column_invisible="True"/>
                            <field name="description" optional="show"/>
                            <field name="diagnosis_area" optional="show" required="1"/>
                            <field name="diagnosis_code" optional="show" required="1" domain="[('diagnosis_area_1','=',diagnosis_area)]"/>
                            <field name="reason" optional="show" required="1"/>
                            <field name="sub_reason" optional="show" required="1" domain="[('reason_code','=',reason)]"/>
                            <field name="resolution" optional="show" required="1"/>
                            <field name="repair_stage" optional="show" required="1"/>
                            <field name="task_id" column_invisible="True"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
