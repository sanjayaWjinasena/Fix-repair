<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Hide UI-only fields on the FSM task form. All fields keep
        their DB columns, computes, and constraints; they're just no
        longer rendered.

          * tag_ids                      (Tags)
          * sale_line_id                 (Sales Order Item)
          * planned_date_begin           (Planned Date / Start date)
          * x_studio_material_availability (Material Availability)

        priority=99 to run after Studio's own inherits so the
        position="attributes" ops find the fields in the merged arch.
    -->
    <record id="project_task_form_hide_fields" model="ir.ui.view">
        <field name="name">project.task.form.hide.fields</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='planned_date_begin']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='x_studio_material_availability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
