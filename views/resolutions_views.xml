<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- resolutions                                               -->
    <!-- ============================================================ -->
    <record id="view_resolutions_form" model="ir.ui.view">
        <field name="name">resolutions.form</field>
        <field name="model">resolutions</field>
        <field name="type">form</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet string="Resolutions">
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="studio_group_6a461b">
                        <group name="studio_group_6a461b_left"/>
                        <group name="studio_group_6a461b_right"/>
                    </group>
                </sheet>
                <div class="oe_chatter" name="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_resolutions_tree" model="ir.ui.view">
        <field name="name">resolutions.tree</field>
        <field name="model">resolutions</field>
        <field name="type">tree</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_resolutions_search" model="ir.ui.view">
        <field name="name">resolutions.search</field>
        <field name="model">resolutions</field>
        <field name="type">search</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="archived_resolutions" domain="[['active', '=', False]]"/>
                <separator/>
            </search>
        </field>
    </record>
    <record id="view_resolutions_tree_inherit" model="ir.ui.view">
        <field name="name">resolutions.tree.inherit</field>
        <field name="model">resolutions</field>
        <field name="type">tree</field>
        <field name="mode">extension</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="view_resolutions_tree"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//tree[1]" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
                <xpath expr="//field[@name='sequence']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string">Resolution</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field optional="show" name="description" string="Description"/>
                    <field optional="show" name="accounting_company_id" string="Company"/>
                </xpath>
            </data>
        </field>
    </record>
    <record id="action_resolutions" model="ir.actions.act_window">
        <field name="name">Resolutions</field>
        <field name="res_model">resolutions</field>
        <field name="view_mode">tree,form</field>
    </record>
  <record id="action_resolutions_2" model="ir.actions.act_window">
    <field name="name">Resolutions</field>
    <field name="res_model">resolutions</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_resolutions_form_2" model="ir.ui.view">
      <field name="name">Default form view for resolutions</field>
      <field name="model">resolutions</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Resolutions">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_6a461b">
      <group name="studio_group_6a461b_left"/>
      <group name="studio_group_6a461b_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_resolutions_list" model="ir.ui.view">
      <field name="name">Default list view for resolutions</field>
      <field name="model">resolutions</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_resolutions_search_2" model="ir.ui.view">
      <field name="name">Default search view for resolutions</field>
      <field name="model">resolutions</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_resolutions" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_default_list_view_for_resolutions_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for resolutions customization</field>
      <field name="model">resolutions</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="Fix-repair.view_resolutions_list"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='sequence']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="string">Resolution</attribute>
  </xpath>
  <xpath expr="//field[@name='name']" position="after">
    <field optional="show" name="description" string="Description"/>
    <field optional="show" name="accounting_company_id" string="Company"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
