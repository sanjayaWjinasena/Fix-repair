<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_1802_success_rate_analysis" model="ir.actions.act_window">
    <field name="name">Success Rate Analysis</field>
    <field name="res_model">helpdesk.ticket.report.analysis</field>
    <field name="view_mode">pivot,graph</field>
    <field name="domain">[('close_date', '&gt;=', '2025-03-11 10:18:26')]</field>
    <field name="context">{
            'search_default_is_close': True,
            'search_default_my_ticket': True,
            'search_default_sla_success': True,
            'search_default_last_7days': True,
            'pivot_measures': ['__count__'],
        }</field>
    <field name="help" type="html"><p class="o_view_nocontent_empty_folder">
                No data yet!
            </p><p>
                Create tickets to get statistics.
            </p>
        </field>
  </record>
</odoo>
