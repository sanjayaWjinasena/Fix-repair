<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_fix_repair" model="ir.ui.view">
        <field name="name">res.config.settings.form.fix.repair</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="Fix Repair"
                     string="Fix Repair"
                     data-key="fix_repair"
                     groups="base.group_system">
                    <h2>Repair Workflow</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="factory_repair_location_id"/>
                                <div class="text-muted">
                                    Items land here when a repair ticket reaches
                                    'Received at Factory'. Per current company.
                                </div>
                                <div class="content-group">
                                    <field name="factory_repair_location_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
