<?xml version="1.0" encoding="utf-8"?>
<!-- Fix-repair: Phase E - 1 views for helpdesk.ticket.type -->
<odoo>
  <data>
    <record id="view_4610_odoo_studio_helpdesk_ticket_type_tree_customization_e" model="ir.ui.view">
      <field name="name">Odoo Studio: helpdesk.ticket.type.tree customization</field>
      <field name="model">helpdesk.ticket.type</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <!-- 2026-10-22: switched off - no Studio views; Fix-repair's own helpdesk_ticket_type_view_tree_repair_config
           (views/helpdesk_ticket_type_views.xml) adds the same four columns, so they showed twice. -->
      <field name="active" eval="False"/>
      <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_tree"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]/field[@name='name']" position="after">
    <field optional="show" name="x_studio_rug" string="RUG"/>
    <field optional="show" name="x_studio_rug_confirmed" string="RUG Confirmed"/>
    <field optional="show" name="x_studio_with_serial_no" string="With Serial No"/>
    <field optional="show" name="x_studio_without_serial_no" string="Without Serial No"/>
    <field name="id" optional="show" column_invisible="1"/>
  </xpath>
</data>
      </field>
    </record>

  </data>
</odoo>