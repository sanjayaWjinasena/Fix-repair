<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the standard quotation/order QWeb template to inject the
         BugFix-Sales Document Introduction above the order lines and
         the Document Conclusion above the payment-terms paragraph.

         Location note: this template inheritance lives in Fix-repair
         even though the fields it renders (bugfix_sales_intro_text /
         bugfix_sales_conclusion_text) are defined by the BugFix-Sales
         module. Fix-repair owns all form / report customizations on
         this instance, so keeping the report inheritance here — and
         declaring BugFix-Sales as a dep in Fix-repair's manifest —
         makes it easy to reason about which module changed what in
         sale.report_saleorder_document.

         Anchor choice notes:
           div[@id='informations']  — customer address block (top of
                                      report body, no t-if wrapping)
           div[hasclass('page')]    — the outer report page container.
                                      Universal — every Odoo 17 sale
                                      report uses `<div class="page">`
                                      as its content wrapper. Safest
                                      possible bottom-of-report anchor.

         Rejected anchors:
           div[@name='total'] — on some Odoo 17 builds (Studio-flattened
             arch) the totals div itself carries a t-if with a sibling
             <div t-else name="signature">. Inserting between them
             breaks QWeb's t-else-must-follow-t-if rule.
           p[@name='order_note'] — missing on Studio-modified builds
             where the terms paragraph has been renamed / removed. Fails
             view validation with "cannot be located in parent view".

         Anchoring the conclusion inside the page div (position=inside
         appends as the last child) puts it at the very bottom of the
         report body — past totals, signature, and any terms/notes.
         Slightly different visual position than "after totals" but
         works reliably across every Odoo 17 arch variant. -->
    <template id="fix_repair_document_intro_conclusion"
              inherit_id="sale.report_saleorder_document">

        <!-- INTRODUCTION: placed right after the customer address block
             (before the order lines table renders). -->
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="doc.bugfix_sales_intro_text"
                 class="mt-3 mb-3"
                 style="white-space: pre-wrap; font-size: 0.95em;">
                <t t-out="doc.bugfix_sales_intro_text"/>
            </div>
        </xpath>

        <!-- CONCLUSION: appended at the end of the report page
             container. Placement: after totals, signature, and
             terms/notes (final content before any oe_structure
             editable footer region). -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div t-if="doc.bugfix_sales_conclusion_text"
                 class="mt-4"
                 style="white-space: pre-wrap; font-size: 0.95em;">
                <t t-out="doc.bugfix_sales_conclusion_text"/>
            </div>
        </xpath>

    </template>

</odoo>
