<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- diagnosis_codes                                           -->
    <!-- ============================================================ -->
    <record id="view_x_diagnosis_codes_form" model="ir.ui.view">
        <field name="name">diagnosis_codes.form</field>
        <field name="model">diagnosis_codes</field>
        <field name="type">form</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet string="Diagnosis Codes">
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="studio_group_484e69">
                        <group name="studio_group_484e69_left"/>
                        <group name="studio_group_484e69_right"/>
                    </group>
                </sheet>
                <div class="oe_chatter" name="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_x_diagnosis_codes_tree" model="ir.ui.view">
        <field name="name">diagnosis_codes.tree</field>
        <field name="model">diagnosis_codes</field>
        <field name="type">tree</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_x_diagnosis_codes_search" model="ir.ui.view">
        <field name="name">diagnosis_codes.search</field>
        <field name="model">diagnosis_codes</field>
        <field name="type">search</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="archived_diagnosis_codes" domain="[['active', '=', False]]"/>
                <separator/>
            </search>
        </field>
    </record>
    <record id="view_x_diagnosis_codes_tree_inherit" model="ir.ui.view">
        <field name="name">diagnosis_codes.tree.inherit</field>
        <field name="model">diagnosis_codes</field>
        <field name="type">tree</field>
        <field name="mode">extension</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="view_x_diagnosis_codes_tree"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//tree[1]" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
                <xpath expr="//field[@name='sequence']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string">Diagnosis Code</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field optional="show" name="description" string="Description"/>
                    <field optional="show" name="diagnosis_area_1" string="Diagnosis Area" options="{'no_create': True}"/>
                    <field optional="show" name="accounting_company_id" string="Company"/>
                </xpath>
            </data>
        </field>
    </record>
    <record id="action_diagnosis_codes" model="ir.actions.act_window">
        <field name="name">Diagnosis Codes</field>
        <field name="res_model">diagnosis_codes</field>
        <field name="view_mode">tree,form</field>
    </record>
  <record id="act_window_2213_diagnosis_codes" model="ir.actions.act_window">
    <field name="name">Diagnosis Codes</field>
    <field name="res_model">diagnosis_codes</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
    <record id="view_4969_default_form_view_for_x_diagnosis_codes_e" model="ir.ui.view">
      <field name="name">Default form view for diagnosis_codes</field>
      <field name="model">diagnosis_codes</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Diagnosis Codes">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_484e69">
      <group name="studio_group_484e69_left"/>
      <group name="studio_group_484e69_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_4968_default_list_view_for_x_diagnosis_codes_e" model="ir.ui.view">
      <field name="name">Default list view for diagnosis_codes</field>
      <field name="model">diagnosis_codes</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
</tree>
      </field>
    </record>
    <record id="view_4970_default_search_view_for_x_diagnosis_codes_e" model="ir.ui.view">
      <field name="name">Default search view for diagnosis_codes</field>
      <field name="model">diagnosis_codes</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <separator/>
  <filter string="Archived" name="archived_diagnosis_codes" domain="[['active', '=', False]]"/>
  <separator/>
</search>
      </field>
    </record>
    <record id="view_final_x_diagnosis_codes_odoo_studio_default_list_view_for_x_diagnosis_codes_customiz" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for diagnosis_codes customization</field>
      <field name="model">diagnosis_codes</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="Fix-repair.view_4968_default_list_view_for_x_diagnosis_codes_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='sequence']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="string">Diagnosis Code</attribute>
  </xpath>
  <xpath expr="//field[@name='name']" position="after">
    <field optional="show" name="description" string="Description"/>
    <field optional="show" name="diagnosis_area_1" string="Diagnosis Area" options="{&quot;no_create&quot;:true}"/>
    <field optional="show" name="accounting_company_id" string="Company"/>
  </xpath>
</data>
      </field>
    </record>
</odoo>
