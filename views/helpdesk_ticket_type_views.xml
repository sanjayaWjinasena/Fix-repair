<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_type_view_form_repair_config" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.form.repair.config</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="rug"/>
                <field name="rug_confirmed"/>
                <field name="with_serial_no"/>
                <field name="without_serial_no"/>
            </xpath>
        </field>
    </record>
    <!--
        v247: tree inherit adding the 4 boolean columns to the
        helpdesk.ticket.type list view. Mirrors Clear-DB's Studio
        arch (view 4610, Fix-repair.view_helpdesk_ticket_type_tree_4610).
        Users on the Configuration → Types list can toggle RUG /
        With Serial No / etc. inline without opening each record.
    -->
    <record id="helpdesk_ticket_type_view_tree_repair_config" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.tree.repair.config</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='name']" position="after">
                <field name="rug" optional="show" string="RUG"/>
                <field name="rug_confirmed" optional="show" string="RUG Confirmed"/>
                <field name="with_serial_no" optional="show" string="With Serial No"/>
                <field name="without_serial_no" optional="show" string="Without Serial No"/>
            </xpath>
        </field>
    </record>
    <record id="view_4610_odoo_studio_helpdesk_ticket_type_tree_customization_e" model="ir.ui.view">
      <field name="name">Odoo Studio: helpdesk.ticket.type.tree customization</field>
      <field name="model">helpdesk.ticket.type</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <!-- 2026-10-22: switched off - no Studio views; Fix-repair's own helpdesk_ticket_type_view_tree_repair_config
           (views/helpdesk_ticket_type_views.xml) adds the same four columns, so they showed twice. -->
      <field name="active" eval="False"/>
      <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_tree"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]/field[@name='name']" position="after">
    <field optional="show" name="rug" string="RUG"/>
    <field optional="show" name="rug_confirmed" string="RUG Confirmed"/>
    <field optional="show" name="with_serial_no" string="With Serial No"/>
    <field optional="show" name="without_serial_no" string="Without Serial No"/>
    <field name="id" optional="show" column_invisible="1"/>
  </xpath>
</data>
      </field>
    </record>
    <record id="helpdesk_ticket_type_view_tree_repair_type" model="ir.ui.view">
    <field name="name">helpdesk.ticket.type.tree.repair_type (Fix-repair)</field>
    <field name="model">helpdesk.ticket.type</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_tree"/>
    <field name="priority">60</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="x_jin_repair_type" optional="show"/>
      </xpath>
    </field>
  </record>
    <record id="helpdesk_ticket_type_view_form_repair_type" model="ir.ui.view">
    <field name="name">helpdesk.ticket.type.form.repair_type (Fix-repair)</field>
    <field name="model">helpdesk.ticket.type</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_type_view_form"/>
    <field name="priority">60</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="x_jin_repair_type"/>
      </xpath>
    </field>
  </record>
</odoo>
