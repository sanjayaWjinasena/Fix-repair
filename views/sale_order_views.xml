<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inject signed_on / signed_by as invisible fields so button visibility
         expressions like "not signed_on" can be evaluated by the client. -->
    <record id="view_order_form_fix_repair_inject_fields" model="ir.ui.view">
        <field name="name">sale.order.form.fix.repair.inject.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <field name="signed_on" invisible="1"/>
                <field name="signed_by" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
