<?xml version="1.0" encoding="UTF-8"?>
<!--
    v259 — Repair Diagnosis notebook tab on project.task.

    First slice of the project.task form port (see chunk 1u in
    the plan file). Mirrors Clear-DB Studio view #3019's "Repair
    Diagnosis" page verbatim: an editable tree of x_task_diagnosis
    rows with 9 catalogue m2o columns + description + sequence
    handle. Only shown on tasks linked to a helpdesk ticket
    (invisible="not helpdesk_ticket_id") so plain project.task
    records outside the repair flow keep their default 3-tab layout.

    The two domain expressions (x_studio_diagnosis_area_1 filter
    on x_studio_diagnosis_code; x_studio_reason_code filter on
    x_studio_sub_reason) mirror Clear-DB's cascading dropdowns.
    Both target fields exist on the Chunk-1a catalogue models:
      x_diagnosis_codes.x_studio_diagnosis_area_1 (m2o)
      x_repair_sub_reason.x_studio_reason_code (m2o)
-->
<odoo>

    <record id="view_project_task_repair_diagnosis" model="ir.ui.view">
        <field name="name">project.task.form.repair.diagnosis</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Sentinel: helpdesk_ticket_id must be present in the
                 composed arch for OWL to evaluate the page's invisible
                 modifier. project_task._get_view adds this at runtime
                 too but view-arch validation runs at install time
                 before _get_view. Belt-and-braces here. -->
            <xpath expr="//sheet" position="inside">
                <field name="helpdesk_ticket_id"
                       invisible="1"
                       string="Help Desk Ticket (sentinel)"/>
                <!-- v266: sentinels for the Tested OK button's invisible
                     expression. project_task._get_view runtime-injects
                     these too, but install-time view validation runs
                     before _get_view. -->
                <field name="x_studio_end_quick_repair" invisible="1"/>
                <field name="x_studio_cancelled" invisible="1"/>
                <field name="material_line_product_count" invisible="1"/>
            </xpath>

            <!-- v265: Tested OK header button — matches Clear-DB's
                 Studio arch verbatim (invisible expression identical),
                 binds to Fix-repair.action_repair_end_quick_repair
                 (delegates to project.task._repair_studio_end_quick_repair
                 in models/project_task.py:521). Insert AFTER the
                 personal_stage_type_id field, same slot Clear-DB
                 view 3019 uses. -->
            <xpath expr="//field[@name='personal_stage_type_id']" position="after">
                <button name="%(Fix-repair.action_repair_end_quick_repair)d"
                        type="action"
                        string="Tested OK"
                        class="btn-primary"
                        invisible="material_line_product_count &gt; 0 or x_studio_cancelled == True or not helpdesk_ticket_id or x_studio_end_quick_repair == True"/>
            </xpath>

            <!-- v261: header field insertions matching Clear-DB Studio
                 view 3019 verbatim. Rename user_ids label + insert
                 helpdesk_ticket_id / x_studio_created_date /
                 x_studio_repair_reason (invisible). Show sale_order_id
                 and rename to Studio's typo "Sales Orderr" for
                 parity. Insert x_studio_priority / _quotation_type /
                 _material_availability after sale_order_id. -->
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="string">Assignees</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="helpdesk_ticket_id"
                       string="Help Desk Ticket"/>
                <field name="x_studio_created_date"/>
                <field name="x_studio_repair_reason" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="string">Sales Orderr</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="after">
                <field name="x_studio_priority"/>
                <field name="x_studio_quotation_type"/>
                <field name="x_studio_material_availability"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <!-- v261: Repair Image tab (Clear-DB view 3019 verbatim) -->
                <page string="Repair Image" name="repair_image">
                    <group>
                        <group>
                            <field name="x_studio_repair_image_01"
                                   widget="image"/>
                        </group>
                        <group>
                            <field name="x_studio_repair_image_02"
                                   widget="image"/>
                        </group>
                    </group>
                </page>
                <!-- v261: Warranty Card tab (Clear-DB view 3019 verbatim) -->
                <page string="Warranty Card" name="warranty_card">
                    <group>
                        <group>
                            <field name="x_studio_warranty_card"
                                   widget="image"/>
                        </group>
                        <group>
                            <field name="x_studio_related_information"
                                   widget="image"/>
                        </group>
                    </group>
                </page>
                <page string="Repair Diagnosis"
                      name="repair_diagnosis"
                      invisible="not helpdesk_ticket_id">
                    <field name="x_studio_diagnosis_ids"
                           nolabel="1"
                           force_save="1">
                        <tree editable="bottom">
                            <field name="x_studio_sequence" widget="handle"/>
                            <field name="x_name" column_invisible="True"/>
                            <field name="x_studio_condition" optional="show"/>
                            <field name="x_studio_symptom_area" optional="show"/>
                            <field name="x_studio_symptom_code" optional="show"/>
                            <field name="x_studio_description" optional="show"/>
                            <field name="x_studio_diagnosis_area" optional="show" required="1"/>
                            <field name="x_studio_diagnosis_code"
                                   optional="show"
                                   required="1"
                                   domain="[('x_studio_diagnosis_area_1','=',x_studio_diagnosis_area)]"/>
                            <field name="x_studio_reason" optional="show" required="1"/>
                            <field name="x_studio_sub_reason"
                                   optional="show"
                                   required="1"
                                   domain="[('x_studio_reason_code','=',x_studio_reason)]"/>
                            <field name="x_studio_resolution" optional="show" required="1"/>
                            <field name="x_studio_repair_stage" optional="show" required="1"/>
                            <field name="x_studio_task_id" column_invisible="True"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
