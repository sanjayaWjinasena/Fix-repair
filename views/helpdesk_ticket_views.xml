    <record id="helpdesk_ticket_form_assign_to_me" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.assign.to.me</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Stored computed field — web_read reads a plain DB varchar, no many2one traversal -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="repair_stage_state" invisible="1"/>
                <field name="task_done" invisible="1"/>
                <field name="repair_picking_count" invisible="1"/>
                <field name="has_ready_dispatch_picking" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_repair_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="repair_picking_count == 0">
                    <field name="repair_picking_count" widget="statinfo" string="Movements"/>
                </button>
            </xpath>

            <!-- Hide the standard helpdesk_stock 'Returns' button — it
                 shows only the ticket's standard picking_ids subset, while
                 our Movements button above captures every transfer
                 stamped with x_studio_helpdesk_ticket_id (returns,
                 dispatches, factory transit, etc). Kept unconditional
                 because our Movements button replaces it on every ticket
                 that renders this form. -->
            <xpath expr="//button[@name='action_view_pickings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//header" position="inside">

                <button name="action_send_to_factory" type="object" string="Send to Factory" class="btn-primary" invisible="repair_stage_state != 'new'"/>

                <button name="action_received_at_factory" type="object" string="Received at Factory" class="btn-primary" invisible="repair_stage_state != 'sent_to_factory'"/>

                <button name="action_send_to_sales_centre" type="object" string="Send to Sales Centre" class="btn-primary" invisible="not task_done"/>

                <button name="action_received_at_sales_centre" type="object" string="Received at Sales Centre" class="btn-primary" invisible="repair_stage_state != 'sent_to_sales_centre'"/>

                <button name="action_assign_to_me" type="object" string="Assign to Me" class="btn-primary" invisible="user_id == uid"/>

            </xpath>

            <!--
                Return (action 195) and Plan Intervention
                (action_generate_fsm_task) recolours are done in
                helpdesk_ticket.py._get_view. Odoo validates XML
                view inherits against the DIRECT PARENT view at
                install time, and this file's parent
                (helpdesk.helpdesk_ticket_view_form, id 3972) does
                NOT declare either button — both are injected by
                downstream inherits (helpdesk_stock adds 195;
                helpdesk_fsm adds action_generate_fsm_task). An
                XML xpath here fails with "cannot be located in
                parent view".

                Python _get_view runs against the fully-merged arch
                (super()'s output), so the buttons are visible when
                the class attribute is set. Same pattern used for
                every other cross-module button we need to touch.
            -->

        </field>
    </record>
    <!--
        Hide a set of ticket-form fields that no longer belong in the
        current UX. All of these keep their DB columns, computes, and
        constraints — they're just no longer rendered on the form.

        Priority 99 to force Odoo to apply this view AFTER Studio's
        own inherits — otherwise the xpath expressions could resolve
        before Studio has finished inserting these fields into the
        merged arch, and the position="attributes" op would be a no-op.
    -->
    <!--
        Disable stage_id statusbar click navigation. Users should
        move through the repair stages only via the workflow buttons
        (Send to Factory / Received at Factory / etc. injected above)
        — clicking a stage on the statusbar directly skips the state
        machine's guards and lets an operator drop the ticket into
        any stage regardless of the workflow's prerequisites (e.g.
        jumping straight to "Received at Sales Centre" without ever
        completing repair).

        `options={'clickable': '0'}` keeps the statusbar visible so
        the salesperson can still see progress, but the individual
        stage pills no longer respond to click. Priority 99 to land
        after Studio's inherits so the option isn't overridden by
        a lower-priority customization stamping clickable back on.
    -->
    <!--
        Lock down the repair-ticket kanban. Rationale:

          * Record drag between columns would change stage_id, bypassing
            the workflow buttons (Send to Factory / Received at Factory /
            etc.) that also do side-effect work (pickings, ticket-linkage
            updates, ...). records_draggable="0" turns this off.
          * Column drag (groups_draggable="0") — reordering the stage
            columns is a global config change that shouldn't happen
            through casual kanban interaction.
          * group_create / group_delete / group_edit off — no + Add
            Column button, no delete in the column gear, no rename via
            the gear. Stages are managed centrally in Helpdesk config.
          * quick_create="0" — hides the + button at the top of each
            column that lets users quickly create tickets by title only.
            Tickets have too many required fields (user, type, product,
            serial, reason, ...) for a title-only create to make sense
            in the repair flow.
          * edit="0" delete="0" plus emptying the kanban-menu template —
            no 3-dots on the card. Editing/deleting must go through the
            form view where the field-level gates and workflow rules
            apply.
          * Remove the activity_ids kanban_activity widget — the clock
            icon and its schedule-activity popover on each card. The
            repair workflow drives activities through the stage-
            transition buttons; freeform activity scheduling from
            kanban muddies the audit trail.

        Priority bumped 99 -> 100 so this inherit lands AFTER Studio's
        kanban customization inherit (id 4735 at priority 99). A
        priority tie was letting Studio's arch win on some renders.
    -->
    <record id="helpdesk_ticket_kanban_no_drag" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.no.drag</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">0</attribute>
                <attribute name="groups_draggable">0</attribute>
                <attribute name="group_create">0</attribute>
                <attribute name="group_delete">0</attribute>
                <attribute name="group_edit">0</attribute>
                <attribute name="quick_create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
            <!--
                Empty out the kanban-menu template so the 3-dots
                dropdown doesn't render. Odoo's kanban runtime checks
                whether the menu template has visible content; with all
                menu items removed there's nothing to show and the
                trigger button hides too.
            -->
            <xpath expr="//templates/t[@t-name='kanban-menu']" position="replace">
                <t t-name="kanban-menu"/>
            </xpath>
            <!-- Remove the activity clock widget from card bodies. -->
            <xpath expr="//field[@name='activity_ids'][@widget='kanban_activity']" position="replace"/>
        </field>
    </record>
    <record id="helpdesk_ticket_form_statusbar_readonly" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.statusbar.readonly</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!--
                Xpath only requires the field name — Odoo validates
                inheritance against the direct parent view at install
                time and the base helpdesk view declares stage_id
                without the widget attribute (widget=statusbar is
                added by a downstream inherit like helpdesk_stage).
                The attributes below still land on the field at
                render time because they merge into the fully-resolved
                arch alongside the widget declaration.

                readonly="1" is the reliable disable path — the
                statusbar widget respects the field's readonly state
                and suppresses click handlers. The `options={'clickable': '0'}`
                approach used in v183/v184 doesn't work because
                Odoo's exprToBoolean treats the string '0' as truthy
                (any non-empty string is truthy in Python), so the
                option resolved to True and pills stayed clickable.

                Workflow buttons (Send to Factory, etc.) don't rely
                on the field being editable in the view — they call
                _move_to_stage() which uses sudo write() bypassing
                view-level readonly. Their advancement path stays
                intact.
            -->
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
    <!-- Safe hides — targets are always present on any DB. Studio-field
         hides moved to views/helpdesk_ticket_studio_field_hides.xml
         and loaded conditionally via post_init_hook so stand-alone
         installs (where those Studio fields aren't in the parent
         view arch) don't crash on unresolvable xpath. -->
    <record id="helpdesk_ticket_form_hide_fields" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.hide.fields</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
